---
// @components/ui/FooterPage.astro
import FlexContainer from '@components/ui/common/FlexContainer.astro';
import Brand from '@components/ui/footer/Brand.astro';
import Navigation from '@components/ui/common/Navigation.astro';
import Socials from '@components/ui/footer/Socials.astro';
import Legal from '@components/ui/footer/Legal.astro';
---

<footer class="footer_page">
  <FlexContainer>
    <Brand />
    <Navigation class="footer_nav" ariaLabel="Navegación del pie de página" />
    <Socials />
  </FlexContainer>

  <Legal />
</footer>

<style>
  .footer_page {
    color: #e2e8f0;
    background-color: #161618;
    padding-block-start: 3rem;
    padding-inline: 1.5rem;
    border-top: 1px solid #2e2e32;
    margin-top: 3rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2rem;
  }

  :global(.footer_nav .nav_link) {
    font-size: 0.9rem;
    color: #a1a1aa;
    transition: color 0.2s ease;

    &:hover {
      color: #ffffff;
    }
  }
</style>
