---
// @components/ui/common/FlexContainer.astro
interface Props {
  maxWidth?: string;
  gap?: string;
  class?: string;
}

const {
  maxWidth = '1200px',
  gap = '1.5rem',
  class: className = '',
} = Astro.props;
---

<div class:list={['flex-container', className]}>
  <slot />
</div>

<style define:vars={{ maxWidth, gap }}>
  .flex-container {
    max-width: var(--maxWidth);
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap);
  }

  @media (max-width: 640px) {
    .flex-container {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
