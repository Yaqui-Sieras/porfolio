---
// @components/ui/common/Image.astro
import type { ImageMetadata } from 'astro';

interface Props {
  src: string | ImageMetadata;
  alt: string;
  width?: number | `${number}`;
  height?: number | `${number}`;
  /*
  loading?: 'lazy' | 'eager';
  decoding?: 'async' | 'sync' | 'auto';
  */
  class?: string;
  blur?: string;
  brightness?: number;
  variant?: 'card' | 'raw';
  caption?: string;
  [key: string]: unknown;
}

const {
  src,
  alt,
  width,
  height,
  class: className = '',
  blur = '0px',
  brightness = 1,
  variant = 'raw',
  caption,
  ...rest
} = Astro.props;

// Extraemos la ruta del string o del objeto de asset para el fondo difuminado
const imageSrc = typeof src === 'string' ? src : src.src;
---

<figure
  class:list={[
    'ui-image-wrapper',
    variant === 'card' && 'ui-image-wrapper--card',
    className,
  ]}
  style={{
    '--bg-img': `url(${imageSrc})`,
    '--effect-blur': blur,
    '--effect-brightness': brightness,
  }}
  {...rest}
>
  <img
    src={imageSrc}
    alt={alt}
    {...(width !== undefined && { width })}
    {...(height !== undefined && { height })}
    class="ui-image__img"
  />

  {caption && <figcaption class="ui-image__caption">{caption}</figcaption>}
</figure>

<style>
  .ui-image-wrapper {
    position: relative;
    margin: 0;
    display: inline-flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* Variante estilo Tarjeta (con efectos de fondo) */
  .ui-image-wrapper--card {
    padding: 1.5rem;
    background-color: #151617;
    border-radius: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ui-image-wrapper--card::before {
    content: '';
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background-image: var(--bg-img);
    background-size: cover;
    background-position: center;
    filter: blur(var(--effect-blur)) brightness(var(--effect-brightness));
    transform: scale(1.1);
    z-index: 0;
  }

  .ui-image__img {
    position: relative;
    z-index: 1;
    max-width: 100%;
    height: auto;
    border-radius: 1rem;
    object-fit: cover;
  }

  /* Leyenda opcional */
  .ui-image__caption {
    position: relative;
    z-index: 1;
    margin-top: 0.75rem;
    text-align: center;
    font-size: 0.875rem;
    color: #a3a3a3;
  }
</style>
