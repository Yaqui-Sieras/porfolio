---
// src/components/ui/header/Navigation.astro
import { NAV_ITEMS } from '@/constants/routes';
import NavItem from '@components/ui/header/NavItem.astro';

const currentPath = Astro.url.pathname;

---

<nav class="navigation">
  {NAV_ITEMS.map((data) => {
    const isActive = currentPath === data.href || (data.href !== '/' && currentPath.startsWith(data.href));
    return (
      <NavItem
        href={data.href}
        label={data.label}
        isActive={isActive}
      />
    );
  })}
</nav>

<style>
  .navigation {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
  }
</style>