---
// src/components/ui/header/Navigation.astro
import { NAV_ITEMS } from '@/constants/routes';
import NavItem from '@components/ui/header/NavItem.astro';

const currentPath = Astro.url.pathname;

---

<nav class="navigation">
  {NAV_ITEMS.map((data) => {
    const isExternal = data.href.startsWith("https://");

    const targetPathname = isExternal ? new URL(data.href).pathname : data.href;

    const isActive = targetPathname === '/'
      ? currentPath === '/'
      : currentPath.startsWith(targetPathname);

    return (
      <NavItem
        href={data.href}
        label={data.label}
        isActive={isActive}
        target={data.target}
      />
    );
  })}
</nav>

<style>
  .navigation {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
  }
</style>