---
// src/components/ui/header/NavItem.astro

interface Props {
  href: string;
  label: string;
  isActive: boolean;
  target?: string;
}

const { href, label, isActive = false, target="_self" } = Astro.props;
const rel = target === '_blank' ? 'noopener noreferrer' : undefined;

---

<a
  href={href}
  class:list={[
    'nav_item',
    { 'nav_item--active': isActive }
  ]}
  target={target}
  rel={rel}
>
  {label}
</a>

<style>
  .nav_item {
    text-decoration: none;
    font-size: 1.1rem;
    font-weight: 600;
    color: #e0e0e0;
    padding: 0.5rem 0.8rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s ease;

    &:hover {
      color: #00d26a;
    }
  }

  .nav_item--active {
    color: #00d26a;
  }
</style>